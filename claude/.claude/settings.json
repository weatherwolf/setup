{
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/home/wolf/.claude/hooks/rename-on-clear.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
