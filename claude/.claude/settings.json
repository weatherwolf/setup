{
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true
  },
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/rename-on-clear.sh",
            "timeout": 120,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/extract-facts-on-clear.sh",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "clear"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/propose-facts-on-start.sh",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/weatherwolf/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "claude-fable-5[1m]",
  "permissions": {
    "defaultMode": "auto"
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/statusline.py",
    "type": "command"
  },
  "theme": "dark",
  "verbose": true
}