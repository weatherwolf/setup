{
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh --version)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rename-on-clear.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/extract-facts-on-clear.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/propose-facts-on-start.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/weatherwolf/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true,
    "posthog@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "custom:theme",
  "verbose": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ]
  }
}
