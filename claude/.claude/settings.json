{
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh --version)",
      "Bash(gh issue list -R fyrm-ai/jordex-boekingen:*)",
      "Bash(gh issue view -R fyrm-ai/jordex-boekingen:*)",
      "Bash(gh pr list -R fyrm-ai/jordex-boekingen:*)",
      "Bash(gh pr view -R fyrm-ai/jordex-boekingen:*)",
      "Bash(gh api repos/fyrm-ai/jordex-boekingen/:*)",
      "Bash(gh issue list -R fyrm-ai/mcp-jit:*)",
      "Bash(gh issue view -R fyrm-ai/mcp-jit:*)",
      "Bash(gh pr list -R fyrm-ai/mcp-jit:*)",
      "Bash(gh pr view -R fyrm-ai/mcp-jit:*)",
      "Bash(gh api repos/fyrm-ai/mcp-jit/:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rename-on-clear.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/extract-facts-on-clear.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/propose-facts-on-start.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/weatherwolf/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "custom:blue_wave",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
