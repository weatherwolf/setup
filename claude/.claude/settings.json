{
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "effortLevel": "medium",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "/home/wolf/.claude/hooks/rename-on-clear.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
