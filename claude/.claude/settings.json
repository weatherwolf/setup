{
  "env": {
    "TZ": "Europe/Amsterdam"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rename-on-clear.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/extract-facts-on-clear.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/propose-facts-on-start.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "sonarqube@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "theme": "dark",
  "verbose": true,
  "skipAutoPermissionPrompt": true
}
